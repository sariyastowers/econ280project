# Load necessary libraries
library(haven)
library(dplyr)
library(fixest)
library(modelsummary)
# ****************** CONFIGURATION ****************** #
setwd("/Users/sariya/Documents/documents_local/econ280project/")
data <- read_dta("data/02_analysis/ms_blel_jpal_wide.dta")
results_path <- "results/table2.xlsx"
set.seed(12345)
# ****************** DATA PREPARATION ****************** #
# Note: You should check if filtering the OLS data too is appropriate for consistency
# OLS Regressions (Can still use df_clean if you want consistent sample size)
reg_ols_m <- feols(m_theta_mle2 ~ treat + m_theta_mle1,
data = data)
reg_ols_h <- feols(h_theta_mle2 ~ treat + h_theta_mle1,
data = data)
# # Now run the fixed effects regressions using the cleaned data
# reg_fe_m <- feols(m_theta_mle2 ~ treat + m_theta_mle1 | strata,
#                   data = data,
#                   vcov = ~strata)
#
# reg_fe_h <- feols(h_theta_mle2 ~ treat + h_theta_mle1 | strata,
#                   data = data,
#                   vcov = ~strata)
# ****************** EXPORT RESULTS ****************** #
# Create a list of the models
model_list <- list(
"(1)" = reg_ols_m,
"(2)" = reg_ols_h,
"(3)" = reg_fe_m,
"(4)" = reg_fe_h
)
# Load necessary libraries
library(haven)
library(dplyr)
library(fixest)
library(modelsummary)
# ****************** CONFIGURATION ****************** #
setwd("/Users/sariya/Documents/documents_local/econ280project/")
data <- read_dta("data/02_analysis/ms_blel_jpal_wide.dta")
results_path <- "results/table2.xlsx"
set.seed(12345)
# ****************** DATA PREPARATION ****************** #
# Note: You should check if filtering the OLS data too is appropriate for consistency
# OLS Regressions (Can still use df_clean if you want consistent sample size)
reg_ols_m <- feols(m_theta_mle2 ~ treat + m_theta_mle1,
data = data)
reg_ols_h <- feols(h_theta_mle2 ~ treat + h_theta_mle1,
data = data)
# # Now run the fixed effects regressions using the cleaned data
# reg_fe_m <- feols(m_theta_mle2 ~ treat + m_theta_mle1 | strata,
#                   data = data,
#                   vcov = ~strata)
#
# reg_fe_h <- feols(h_theta_mle2 ~ treat + h_theta_mle1 | strata,
#                   data = data,
#                   vcov = ~strata)
# ****************** EXPORT RESULTS ****************** #
# Create a list of the models
model_list <- list(
"(1)" = reg_ols_m,
"(2)" = reg_ols_h,
"(3)" = reg_fe_m,
"(4)" = reg_fe_h
)
